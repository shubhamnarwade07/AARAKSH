# ============================================================
# AARAKSH — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# ============================================================
# DEMO MODE
# ============================================================
# Set to "true" to enable demo mode (uses mock data)
# Set to "false" to connect to real backend (Phase 2+)
VITE_DEMO_MODE=true

# ============================================================
# API (Phase 2 — FastAPI Backend)
# ============================================================
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_API_TIMEOUT=10000

# ============================================================
# SUPABASE (Phase 2 — Authentication & Database)
# ============================================================
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# MAP (Tile Service)
# ============================================================
# Using OpenFreeMap by default (no key needed)
# Uncomment to use Mapbox or Maptiler:
# VITE_MAPTILER_API_KEY=your-key-here
# VITE_MAP_STYLE=https://api.maptiler.com/maps/streets/style.json?key={VITE_MAPTILER_API_KEY}

# ============================================================
# IOT GATEWAY (Phase 4 — MQTT)
# ============================================================
# VITE_MQTT_BROKER_URL=wss://your-broker.example.com:8884/mqtt
# VITE_MQTT_USERNAME=
# VITE_MQTT_PASSWORD=

# ============================================================
# ANALYTICS / MONITORING (Future)
# ============================================================
# VITE_SENTRY_DSN=
